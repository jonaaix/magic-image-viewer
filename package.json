{
    "name": "magic-image-viewer",
    "description": "Opens any image on any web page in a full-screen viewer with zoom, pan and a gallery of every picture on the page.",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jonaaix/magic-image-viewer.git"
    },
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox --mv3",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox --mv3",
        "build:test": "wxt build --mode test",
        "build:test:firefox": "wxt build -b firefox --mv3 --mode test",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox --mv3",
        "test": "npm run test:unit && npm run build:test && playwright test",
        "test:unit": "node --test tests/unit/*.test.js",
        "postinstall": "wxt prepare",
        "icons": "node scripts/render-icons.mjs"
    },
    "dependencies": {
        "@aaix/laravel-islands": "github:jonaaix/laravel-islands#v1.0.177",
        "@aaix/laravel-islands-gallery": "github:jonaaix/laravel-islands-gallery#v1.0.13",
        "vue": "^3.5.42"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@wxt-dev/module-vue": "^1.0.3",
        "tailwindcss": "^4.3.3",
        "wxt": "^0.21.5"
    }
}
